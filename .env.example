# Server
PORT=3001
NODE_ENV=development

# Database (local development uses SQLite)
DATABASE_URL="file:./dev.db"
# Production (prisma/schema.prod.prisma) needs a PostgreSQL URL, e.g. Neon:
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Upstream AI (your gemini-web2api instance)
UPSTREAM_AI_URL="http://localhost:8081"

# Security
API_SALT="change-me-in-production"

# Comma-separated list of allowed browser origins. Empty = allow all.
# Example: CORS_ORIGIN="https://ai-secure-proxy.onrender.com"
CORS_ORIGIN=""

# Set to false on small instances: the ONNX model needs ~150 MB and 8 s to load.
SEMANTIC_ENABLED=true

# Stripe (for monetization - add when ready)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Language detection
ENABLE_LLM_JUDGE=false
LLM_JUDGE_URL=""
