{
  "name": "ai-secure-proxy",
  "version": "1.0.0",
  "description": "AI security proxy that scans prompts for jailbreak attempts before they reach your model",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "migrate": "prisma migrate dev",
    "seed": "tsx scripts/seed.ts",
  "eval:semantic": "node scripts/eval-semantic.cjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "security",
    "proxy",
    "jailbreak",
    "typescript"
  ],
  "author": "Aaryan Prasad Dangal",
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@prisma/client": "^5.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "franc": "^5.0.0",
    "helmet": "^7.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/franc": "^5.0.3",
    "@types/node": "^20.11.0",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
