// Production schema — PostgreSQL.
//
// Prisma cannot switch `provider` by environment variable, so production has
// its own schema file. Keep the models below identical to prisma/schema.prisma
// (which stays SQLite for local development).
//
//   npm run db:push:prod     apply this schema to the database in DATABASE_URL
//   npm run prisma:generate:prod   generate the client for this schema
//
// Changing a model means changing it in both files.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id             String   @id @default(uuid())
  email          String   @unique
  apiKey         String   @unique
  plan           String   @default("free") // free, starter, pro
  requestsUsed   Int      @default(0)
  requestsLimit  Int      @default(1000)
  blockThreshold Int      @default(60) // risk score at which a prompt is blocked (10-100)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  scans          Scan[]
  blockRules     BlockRule[]
}

model Scan {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  prompt       String?
  hasImage     Boolean  @default(false)
  messageCount Int      @default(1)
  blockedRole  String?
  language     String?
  verdict      String // safe, blocked, flagged
  reason       String?
  riskScore    Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
}

model BlockRule {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  pattern    String
  isRegex    Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([customerId])
}
